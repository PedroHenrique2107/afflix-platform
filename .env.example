NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://afflix:afflix_local_only@localhost:5432/afflix?schema=public"
# true or false
SHOPEE_MOCK_MODE=
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=
