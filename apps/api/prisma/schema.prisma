generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Marketplace {
  SHOPEE
}

enum PublicationStatus {
  DRAFT
  READY
  PUBLISHED_MANUALLY
  ARCHIVED
}

model Product {
  id                  String   @id @default(uuid()) @db.Uuid
  marketplace         Marketplace @default(SHOPEE)
  shopId              String
  itemId              String
  name                String
  productUrl          String
  offerUrl            String?
  imageUrl            String?
  price               Decimal? @db.Decimal(12, 2)
  priceMax            Decimal? @db.Decimal(12, 2)
  commissionRate      Decimal? @db.Decimal(10, 6)
  estimatedCommission Decimal? @db.Decimal(12, 2)
  rating              Decimal? @db.Decimal(3, 2)
  sales               Int?
  lastSyncedAt        DateTime @default(now())
  isArchived          Boolean @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  snapshots           PriceSnapshot[]
  links               AffiliateLink[]
  publications        Publication[]

  @@unique([marketplace, shopId, itemId])
  @@index([commissionRate])
  @@index([lastSyncedAt])
}

model PriceSnapshot {
  id             String @id @default(uuid()) @db.Uuid
  productId      String @db.Uuid
  price          Decimal? @db.Decimal(12, 2)
  commissionRate Decimal? @db.Decimal(10, 6)
  observedAt     DateTime @default(now())
  product        Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@index([productId, observedAt])
}

model AffiliateLink {
  id         String @id @default(uuid()) @db.Uuid
  productId  String @db.Uuid
  channel    String
  campaign   String?
  subIds     Json
  shortUrl   String
  // sha256 de productId+channel+campaign+subIds normalizados: impede link duplicado para o mesmo pedido.
  dedupeKey  String   @unique
  createdAt  DateTime @default(now())
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  publications Publication[]
  @@index([productId, channel])
}

model MediaAsset {
  id              String @id @default(uuid()) @db.Uuid
  title           String
  storagePath     String
  sha256          String?
  sourceUrl       String?
  licenseType     String
  rightsEvidence  String?
  licenseExpiresAt DateTime?
  createdAt       DateTime @default(now())
  publications    Publication[]
}

model Publication {
  id             String @id @default(uuid()) @db.Uuid
  productId      String @db.Uuid
  mediaAssetId   String? @db.Uuid
  // Link que vai no briefing. Precisa ser do mesmo produto; obrigatório para sair de DRAFT.
  affiliateLinkId String? @db.Uuid
  channel        String
  status         PublicationStatus @default(DRAFT)
  caption        String?
  cta            String?
  externalUrl    String?
  publishedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  product        Product @relation(fields: [productId], references: [id])
  mediaAsset     MediaAsset? @relation(fields: [mediaAssetId], references: [id])
  affiliateLink  AffiliateLink? @relation(fields: [affiliateLinkId], references: [id])
  metrics        PublicationMetric[]
  @@index([status, channel])
}

enum MetricKind {
  VIEWS
  CLICKS
  ORDERS
  COMMISSION
}

// Separa número anotado pelo operador de número tirado de relatório oficial (painel de afiliados, insights do canal).
enum MetricSource {
  MANUAL
  OFFICIAL_REPORT
}

// Valor acumulado observado num instante (RF11): o relatório usa o último registro por publicação, métrica e fonte.
// Fonte, referência da origem e data de observação são obrigatórias: nenhum número existe sem origem.
model PublicationMetric {
  id              String       @id @default(uuid()) @db.Uuid
  publicationId   String       @db.Uuid
  kind            MetricKind
  // Contagens são inteiras; COMMISSION é BRL. Decimal único para não usar float em dinheiro.
  value           Decimal      @db.Decimal(14, 2)
  source          MetricSource
  sourceReference String
  observedAt      DateTime
  createdAt       DateTime     @default(now())
  publication     Publication  @relation(fields: [publicationId], references: [id])
  @@index([publicationId, kind, source, observedAt])
}
